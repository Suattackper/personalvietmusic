@inject ILocalStorageService Storage
@inject IJSRuntime JS
@implements IDisposable

<button class="icon-button theme-toggle"
        title="@Lang.T(_isDark ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối")"
        aria-label="@Lang.T(_isDark ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối")"
        @onclick="ToggleThemeAsync">
    <Icon Name="@(_isDark ? "sun" : "moon")" Size="20" />
</button>

@code {
    private bool _isDark = true;

    private void RefreshLanguage() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        Lang.OnChange += RefreshLanguage;
        // Mặc định dark mode; index.html đã áp theme sớm để tránh chớp màu.
        var saved = await Storage.GetItemAsync(StorageKeys.Theme);
        _isDark = saved != "light";
        await ApplyAsync();
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await ApplyAsync();
        await Storage.SetItemAsync(StorageKeys.Theme, _isDark ? "dark" : "light");
    }

    private async Task ApplyAsync()
    {
        await JS.InvokeVoidAsync("vietmusicTheme.apply", _isDark ? "dark" : "light");
    }

    public void Dispose() => Lang.OnChange -= RefreshLanguage;
}
