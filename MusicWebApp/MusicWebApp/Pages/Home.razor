@page "/"
@inject NavigationManager Nav
@inject PlaylistService PlaylistSvc

<PageTitle>AnhTanMusic - @Lang.T("Nhạc Việt")</PageTitle>

<section class="page-section">
    <div class="home-hero">
        <h1 class="page-heading">@Lang.T("Chào mừng đến với AnhTanMusic 🎵")</h1>
        <p class="home-hero-subtitle">
            @Lang.T("Khám phá và nghe nhạc yêu thích của bạn. Chọn một bộ sưu tập hoặc tìm kiếm bài hát bất kỳ.")
        </p>
    </div>

    @if (_playlists is { Count: > 0 })
    {
        <h2 class="section-heading">@Lang.T("🌍 Nhạc Việt, Anh, Nhật, Trung")</h2>
        <p class="page-subtitle">@Lang.T("Mở từng danh sách để tìm và chọn bài bạn muốn nghe.")</p>
        <div class="playlist-grid country-playlist-grid">
            @foreach (var playlist in _playlists.Where(p => p.Id.StartsWith("country-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
        <h2 class="section-heading">@Lang.T("✨ Nhạc mới 2025–2026")</h2>
        <div class="playlist-grid country-playlist-grid">
            @foreach (var playlist in _playlists.Where(p => p.Id.StartsWith("recent-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
        <h2 class="section-heading">@Lang.T("🎶 Nghe ngay — playlist có sẵn")</h2>
        <div class="playlist-grid">
            @foreach (var playlist in _playlists.Where(p => !p.Id.StartsWith("country-") && !p.Id.StartsWith("recent-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
    }

    <h2 class="section-heading">@Lang.T("Khám phá theo thể loại")</h2>
    <div class="genre-grid">
        @foreach (var genre in Genres)
        {
            <button class="genre-card"
                    title="@Lang.F("Tìm kiếm {0}", Lang.T(genre.Name))"
                    aria-label="@Lang.F("Tìm kiếm {0}", Lang.T(genre.Name))"
                    @onclick="() => SearchGenre(genre.Name)">
                <span class="genre-card-icon" aria-hidden="true">@genre.Emoji</span>
                <span class="genre-card-name">@Lang.T(genre.Name)</span>
            </button>
        }
    </div>
</section>

@code {
    private IReadOnlyList<CuratedPlaylist>? _playlists;

    protected override async Task OnInitializedAsync()
    {
        _playlists = await PlaylistSvc.GetPlaylistsAsync();
    }

    private static readonly (string Name, string Emoji)[] Genres =
    {
        ("Nhạc Việt mới", "🎵"),
        ("V-Pop", "🎤"),
        ("Nhạc trẻ Việt Nam", "🎧"),
        ("Ballad Việt", "💜"),
        ("Rap Việt", "🔥"),
        ("Chill Việt", "🌙"),
        ("Acoustic Việt", "🎸")
    };

    private void SearchGenre(string genre)
    {
        Nav.NavigateTo($"search?q={Uri.EscapeDataString(genre)}");
    }
}
