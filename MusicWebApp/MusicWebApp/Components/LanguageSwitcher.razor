@implements IDisposable
<AppDropdown Label="@Lang.T("Ngôn ngữ")" Value="@Lang.Code" Options="_options" ValueChanged="ChangeLanguage" AdditionalClass="language-switcher" />

@code {
    private readonly IReadOnlyList<DropdownOption> _options =
    [
        new("vi", "Tiếng Việt", "VI"),
        new("en", "English", "EN")
    ];

    protected override void OnInitialized() => Lang.OnChange += RefreshLanguage;

    private void RefreshLanguage() => _ = InvokeAsync(StateHasChanged);

    private async Task ChangeLanguage(string value) => await Lang.SetAsync(value);

    public void Dispose() => Lang.OnChange -= RefreshLanguage;
}
