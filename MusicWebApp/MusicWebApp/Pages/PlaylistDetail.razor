@page "/playlist/{PlaylistId}"
@inject PlaylistService PlaylistSvc
@inject MusicPlayerState PlayerState
@inject ToastService Toasts

<PageTitle>@Lang.T(_playlist?.Name ?? "Playlist") - AnhTanMusic</PageTitle>

<section class="page-section">
    @if (_playlist is null && !_loaded)
    {
        <LoadingIndicator Text="Đang tải playlist..." />
    }
    else if (_playlist is null)
    {
        <EmptyState IconName="disc"
                    Title="Không tìm thấy playlist"
                    Description="Playlist này không tồn tại hoặc đã bị xóa.">
            <a class="button-primary" href="playlists">@Lang.T("Xem tất cả playlist")</a>
        </EmptyState>
    }
    else
    {
        <div class="page-heading-row">
            <h1 class="page-heading">
                <span class="page-heading-icon playlist-heading-emoji" aria-hidden="true">@_playlist.Emoji</span>
                @Lang.T(_playlist.Name)
            </h1>
            <div class="playlist-actions">
                <button class="button-primary" @onclick="PlayAll">
                    <Icon Name="play" Size="16" />
                    @Lang.T("Phát tất cả")
                </button>
                <button class="button-secondary" @onclick="PlayShuffled">
                    <Icon Name="shuffle" Size="16" />
                    @Lang.T("Phát ngẫu nhiên")
                </button>
            </div>
        </div>
        <p class="page-subtitle">@Lang.T(_playlist.Description) — @Lang.F("{0} bài", _tracks.Count)</p>

        @if (IsCountryCollection)
        {
            <div class="playlist-find">
                <label for="playlist-search">@Lang.T("Tìm bài trong danh sách")</label>
                <input id="playlist-search" type="search" placeholder="@Lang.T("Tên bài hát hoặc nghệ sĩ...")"
                       @bind="_query" @bind:event="oninput" />
                <span>@VisibleTracks.Count / @Lang.F("{0} bài", _tracks.Count)</span>
            </div>
        }

        @if (VisibleTracks.Count == 0)
        {
            <EmptyState IconName="search" Title="Không tìm thấy bài hát"
                        Description="Thử tìm bằng tên bài hoặc nghệ sĩ khác." />
        }
        else
        {
            <TrackList Tracks="VisibleTracks" />
        }
    }
</section>

@code {
    [Parameter] public string PlaylistId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "autoplay")]
    public string? Autoplay { get; set; }

    private CuratedPlaylist? _playlist;
    private List<MusicTrack> _tracks = new();
    private bool _loaded;
    private string? _loadedId;
    private string _query = string.Empty;
    private bool IsCountryCollection => _playlist?.Id.StartsWith("country-") == true || _playlist?.Id.StartsWith("recent-") == true || _playlist?.Id.StartsWith("tiktok-") == true;
    private IReadOnlyList<MusicTrack> VisibleTracks => string.IsNullOrWhiteSpace(_query)
        ? _tracks
        : _tracks.Where(t => t.Title.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)
                          || t.Artist.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (PlaylistId == _loadedId)
        {
            return;
        }

        _loadedId = PlaylistId;
        _loaded = false;
        _query = string.Empty;
        _playlist = await PlaylistSvc.GetByIdAsync(PlaylistId);
        _tracks = _playlist?.Tracks.Select(t => t.ToMusicTrack()).ToList() ?? new List<MusicTrack>();
        _loaded = true;

        // Bấm vào card playlist => phát luôn toàn bộ.
        if (Autoplay == "1" && _tracks.Count > 0)
        {
            PlayerState.SetQueue(_tracks, 0);
        }
    }

    private void PlayAll()
    {
        var tracks = VisibleTracks;
        if (tracks.Count == 0)
        {
            return;
        }

        PlayerState.SetQueue(tracks, 0);
        Toasts.ShowSuccess(Lang.F("Đang phát playlist \"{0}\" ({1} bài).", Lang.T(_playlist!.Name), tracks.Count));
    }

    private void PlayShuffled()
    {
        var tracks = VisibleTracks;
        if (tracks.Count == 0)
        {
            return;
        }

        if (!PlayerState.IsShuffle)
        {
            PlayerState.ToggleShuffle();
        }
        PlayerState.SetQueue(tracks, Random.Shared.Next(tracks.Count));
        Toasts.ShowSuccess(Lang.F("Đang phát ngẫu nhiên \"{0}\".", Lang.T(_playlist!.Name)));
    }
}
