@inject MusicPlayerState PlayerState
@inject RecentlyPlayedService Recent
@inject FavoritesService Favorites
@inject ToastService Toasts
@inject LyricsService Lyrics
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Khung video YouTube nổi (iframe duy nhất, luôn tồn tại trong DOM).
   Nút tròn kiểu chatbot bên cạnh để ẩn/hiện. Khi ẩn dùng opacity:0 (KHÔNG
   display:none) để giữ kích thước hợp lệ -> nhạc vẫn phát. *@
<div class="player-video-box @(PlayerState.CurrentTrack is null ? "empty" : null) @(_videoVisible ? null : "collapsed")">
    <div id="youtube-player-host"></div>
</div>
<button class="video-toggle-btn @(_videoVisible ? "is-open" : null)"
        title="@Lang.T(_videoVisible ? "Ẩn khung video" : "Hiện khung video")"
        aria-label="@Lang.T(_videoVisible ? "Ẩn khung video" : "Hiện khung video")"
        aria-pressed="@_videoVisible"
        @onclick="ToggleVideo">
    <Icon Name="@(_videoVisible ? "chevron-down" : "video")" Size="22" />
</button>

<footer class="player-bar @(_visualState)" aria-label="@Lang.T("Trình phát nhạc")">
    <div class="player-info" @key="PlayerState.CurrentTrack?.VideoId">
        @if (PlayerState.CurrentTrack is not null)
        {
            @if (!string.IsNullOrEmpty(PlayerState.CurrentTrack.ThumbnailUrl))
            {
                <div class="mini-vinyl @(_visualState == "is-playing" ? "is-playing" : null)">
                    <span class="mini-vinyl-spectrum" aria-hidden="true"></span>
                    <span class="mini-vinyl-disc">
                        <img class="player-thumb"
                             src="@PlayerState.CurrentTrack.ThumbnailUrl"
                             alt="@Lang.F("Ảnh bìa {0}", PlayerState.CurrentTrack.Title)" />
                    </span>
                </div>
            }
            <div class="player-track-meta">
                <span class="player-track-title" title="@PlayerState.CurrentTrack.Title">
                    @PlayerState.CurrentTrack.Title
                </span>
                <span class="player-track-artist" title="@PlayerState.CurrentTrack.Artist">
                    @PlayerState.CurrentTrack.Artist
                </span>
            </div>
            <button class="icon-button player-fav-button @(IsCurrentFavorite ? "is-favorite" : null)"
                    title="@Lang.T(IsCurrentFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")"
                    aria-label="@Lang.T(IsCurrentFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")"
                    @onclick="ToggleCurrentFavoriteAsync">
                <Icon Name="@(IsCurrentFavorite ? "heart-filled" : "heart")" Size="18" />
            </button>
            <button class="icon-button now-open-button" title="@Lang.T("Mở chế độ nghe tập trung")" aria-label="@Lang.T("Mở chế độ nghe tập trung")" @onclick="OpenNowPlaying">
                <Icon Name="expand" Size="18" />
            </button>
        }
        else
        {
            <div class="player-thumb player-thumb-placeholder" aria-hidden="true">
                <Icon Name="music" Size="24" />
            </div>
            <div class="player-track-meta">
                <span class="player-track-title muted">@Lang.T("Chưa phát bài nào")</span>
                <span class="player-track-artist muted">@Lang.T("Chọn một bài hát để bắt đầu")</span>
            </div>
        }
    </div>

    <div class="player-center">
        <div class="player-controls">
            <button class="icon-button @(PlayerState.IsShuffle ? "control-active" : null)"
                    title="@Lang.T(PlayerState.IsShuffle ? "Tắt phát ngẫu nhiên" : "Bật phát ngẫu nhiên")"
                    aria-label="@Lang.T(PlayerState.IsShuffle ? "Tắt phát ngẫu nhiên" : "Bật phát ngẫu nhiên")"
                    aria-pressed="@PlayerState.IsShuffle"
                    @onclick="PlayerState.ToggleShuffle">
                <Icon Name="shuffle" Size="18" />
            </button>
            <button class="icon-button"
                    title="@Lang.T("Bài trước")"
                    aria-label="@Lang.T("Bài trước")"
                    disabled="@(PlayerState.Queue.Count == 0)"
                    @onclick="PlayPrevious">
                <Icon Name="previous" Size="20" />
            </button>
            <button class="play-button @(_visualState)"
                    title="@Lang.T(PlayerState.IsPlaying ? "Tạm dừng" : "Phát")"
                    aria-label="@Lang.T(PlayerState.IsPlaying ? "Tạm dừng" : "Phát")"
                    disabled="@(PlayerState.CurrentTrack is null)"
                    @onclick="TogglePlayPause">
                <Icon Name="@(PlayerState.IsPlaying ? "pause" : "play")" Size="22" />
            </button>
            <button class="icon-button"
                    title="@Lang.T("Bài tiếp theo")"
                    aria-label="@Lang.T("Bài tiếp theo")"
                    disabled="@(PlayerState.Queue.Count == 0)"
                    @onclick="PlayNext">
                <Icon Name="next" Size="20" />
            </button>
            <button class="icon-button repeat-button @(PlayerState.RepeatMode != RepeatMode.None ? "control-active" : null)"
                    title="@RepeatTitle"
                    aria-label="@RepeatTitle"
                    @onclick="PlayerState.ChangeRepeatMode">
                <Icon Name="repeat" Size="18" />
                @if (PlayerState.RepeatMode == RepeatMode.One)
                {
                    <span class="repeat-one-badge" aria-hidden="true">1</span>
                }
            </button>
        </div>
        <div class="player-progress">
            <span class="player-time" aria-label="@Lang.T("Thời gian hiện tại")">@FormatTime(DisplayTime)</span>
            <input type="range"
                   class="progress-slider"
                   min="0"
                   max="@Inv(SliderMax)"
                   step="any"
                   value="@Inv(Math.Clamp(DisplayTime, 0, SliderMax))"
                   aria-label="@Lang.T("Thanh tiến trình bài hát")"
                   disabled="@(PlayerState.CurrentTrack is null || PlayerState.Duration <= 0)"
                   @oninput="OnSeekInput"
                   @onchange="OnSeekCommitAsync" />
            <span class="seek-preview" aria-hidden="true" style="left:@Inv(PlayerState.Duration > 0 ? Math.Clamp(DisplayTime / PlayerState.Duration * 100, 0, 100) : 0)%">@FormatTime(DisplayTime)</span>
            <span class="player-time" aria-label="@Lang.T("Tổng thời lượng")">@FormatTime(PlayerState.Duration)</span>
        </div>
    </div>

    <div class="player-extras">
        <label class="motion-level-picker">@Lang.T("Hiệu ứng")
            <select value="@_motionLevel" @onchange="ChangeMotionLevelAsync" aria-label="@Lang.T("Mức hiệu ứng")">
                <option value="off">@Lang.T("Tắt")</option><option value="light">@Lang.T("Nhẹ")</option><option value="full">@Lang.T("Đầy đủ")</option>
            </select>
        </label>
        <span class="volume-icon" aria-hidden="true">
            <Icon Name="@(PlayerState.Volume == 0 ? "volume-mute" : "volume")" Size="18" />
        </span>
        <input type="range"
               class="volume-slider"
               min="0"
               max="100"
               step="1"
               value="@PlayerState.Volume"
               aria-label="@Lang.T("Âm lượng")"
               @oninput="OnVolumeChangedAsync" />
    </div>
</footer>

@if (_nowPlayingOpen && PlayerState.CurrentTrack is not null)
{
    <div id="now-playing" class="now-playing-backdrop stage-theme-@_stageTheme @(_stageOpen ? "stage-mode" : null)" role="presentation" @onclick="CloseNowPlaying">
        <section id="now-playing-panel" class="now-playing-panel @(_stageOpen ? "stage-mode" : null)" role="dialog" aria-modal="true" aria-label="@Lang.T("Đang phát")" @onclick:stopPropagation="true">
            <div class="now-playing-glow" style="background-image:url('@PlayerState.CurrentTrack.ThumbnailUrl')" aria-hidden="true"></div>
            <div class="stage-aurora" aria-hidden="true"></div>
            <button class="icon-button now-close" data-now-close title="@Lang.T("Đóng chế độ nghe tập trung")" aria-label="@Lang.T("Đóng chế độ nghe tập trung")" @onclick="CloseNowPlaying"><Icon Name="close" Size="22" /></button>
            <p class="now-playing-eyebrow">@Lang.T("Đang phát")</p>
            <div class="stage-art-wrap @(_vinylMode ? "vinyl-mode" : null) @(_visualState == "is-playing" ? "is-playing" : null)" @key="PlayerState.CurrentTrack.VideoId">
                <canvas id="stage-visualizer" class="stage-visualizer" aria-hidden="true"></canvas>
                @if (!string.IsNullOrEmpty(PlayerState.CurrentTrack.ThumbnailUrl))
                {
                    <img class="now-playing-art" src="@PlayerState.CurrentTrack.ThumbnailUrl" alt="@Lang.F("Ảnh bìa {0}", PlayerState.CurrentTrack.Title)" />
                }
                else
                {
                    <div class="now-playing-art art-fallback" aria-hidden="true"><Icon Name="music" Size="64" /></div>
                }
            </div>
            <h2>@PlayerState.CurrentTrack.Title</h2>
            <p class="now-playing-artist">@PlayerState.CurrentTrack.Artist</p>
            <div class="stage-options" aria-label="@Lang.T("Tùy chọn hiển thị")">
                <button class="button-secondary" @onclick="ToggleVinyl" aria-pressed="@_vinylMode">@Lang.T("Đĩa vinyl")</button>
                <button class="button-secondary" @onclick="ToggleVisualizerMode">@Lang.T(_visualizerMode == "ring" ? "Phổ vòng" : "Phổ ngang")</button>
                <button class="button-secondary" @onclick="ToggleStageAsync" aria-pressed="@_stageOpen">@Lang.T(_stageOpen ? "Thu gọn sân khấu" : "Mở sân khấu")</button>
            </div>
            <label class="stage-theme-picker">@Lang.T("Không gian nghe")
                <select value="@_stageTheme" @onchange="ChangeStageThemeAsync">
                    <option value="neon">Neon City</option><option value="rain">@Lang.T("Mưa đêm")</option><option value="vinyl">@Lang.T("Phòng đĩa than")</option>
                </select>
            </label>
            <p class="visualizer-disclaimer">@Lang.T("Hiệu ứng phổ mô phỏng — nguồn YouTube không cung cấp dữ liệu âm thanh cho trang này.")</p>
            <div class="now-playing-progress">
                <span>@FormatTime(DisplayTime)</span>
                <input type="range" min="0" max="@Inv(SliderMax)" step="any" value="@Inv(Math.Clamp(DisplayTime, 0, SliderMax))" aria-label="@Lang.T("Thanh tiến trình bài hát")" disabled="@(PlayerState.Duration <= 0)" @oninput="OnSeekInput" @onchange="OnSeekCommitAsync" />
                <span class="seek-preview" aria-hidden="true" style="left:@Inv(PlayerState.Duration > 0 ? Math.Clamp(DisplayTime / PlayerState.Duration * 100, 0, 100) : 0)%">@FormatTime(DisplayTime)</span>
                <span>@FormatTime(PlayerState.Duration)</span>
            </div>
            <div class="now-playing-controls">
                <button class="icon-button" title="@Lang.T("Bài trước")" aria-label="@Lang.T("Bài trước")" disabled="@(PlayerState.Queue.Count == 0)" @onclick="PlayPrevious"><Icon Name="previous" Size="24" /></button>
                <button class="play-button" title="@Lang.T(PlayerState.IsPlaying ? "Tạm dừng" : "Phát")" aria-label="@Lang.T(PlayerState.IsPlaying ? "Tạm dừng" : "Phát")" @onclick="TogglePlayPause"><Icon Name="@(PlayerState.IsPlaying ? "pause" : "play")" Size="25" /></button>
                <button class="icon-button" title="@Lang.T("Bài tiếp theo")" aria-label="@Lang.T("Bài tiếp theo")" disabled="@(PlayerState.Queue.Count == 0)" @onclick="PlayNext"><Icon Name="next" Size="24" /></button>
            </div>
            <div class="now-playing-bottom">
                <button class="icon-button @(IsCurrentFavorite ? "is-favorite" : null)" title="@Lang.T(IsCurrentFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")" aria-label="@Lang.T(IsCurrentFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")" @onclick="ToggleCurrentFavoriteAsync"><Icon Name="@(IsCurrentFavorite ? "heart-filled" : "heart")" Size="20" /></button>
                <label class="motion-level-picker">@Lang.T("Hiệu ứng")
                    <select value="@_motionLevel" @onchange="ChangeMotionLevelAsync" aria-label="@Lang.T("Mức hiệu ứng")">
                        <option value="off">@Lang.T("Tắt")</option><option value="light">@Lang.T("Nhẹ")</option><option value="full">@Lang.T("Đầy đủ")</option>
                    </select>
                </label>
                <Icon Name="@(PlayerState.Volume == 0 ? "volume-mute" : "volume")" Size="18" />
                <input type="range" min="0" max="100" value="@PlayerState.Volume" aria-label="@Lang.T("Âm lượng")" @oninput="OnVolumeChangedAsync" />
            </div>
            @if (_systemReducedMotion) { <p class="now-playing-motion-status" aria-live="polite">@Lang.T("Thiết bị đang giảm chuyển động.")</p> }
            <div class="stage-lyrics">
                <h3>@Lang.T("Lời bài hát")</h3>
                @if (_lyrics?.Lines.Count > 0)
                {
                    @if (!_lyricsAutoScroll) { <button class="button-secondary" @onclick="ResumeLyrics">@Lang.T("Theo lời đang hát")</button> }
                    <div class="lyrics-scroll" @onwheel="PauseLyricsScroll" @ontouchstart="PauseLyricsScroll">
                        @for (var i = 0; i < _lyrics.Lines.Count; i++)
                        {
                            var line = _lyrics.Lines[i];
                            <p id="lyric-line-@i" class="lyric-line @(i == ActiveLyricIndex ? "active" : null)">
                                @if (line.Words.Count > 0)
                                {
                                    @foreach (var word in line.Words)
                                    {
                                        <span class="@(PlayerState.CurrentTime * 1000 >= word.StartMs && PlayerState.CurrentTime * 1000 < word.EndMs ? "active-word" : null)">@word.Text </span>
                                    }
                                }
                                else { @line.Text }
                            </p>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_lyrics?.Text))
                {
                    <p class="lyrics-static">@_lyrics.Text</p>
                }
                else { <p>@Lang.T("Chưa có lời bài hát được cấp cho bài này.")</p> }
            </div>
            <a class="button-secondary stage-queue-link" href="queue" @onclick="CloseNowPlaying">@Lang.T("Mở hàng đợi")</a>
        </section>
    </div>
}

@code {
    private DotNetObjectReference<MusicPlayer>? _dotNetRef;
    private bool _playerReady;
    private string? _loadedVideoId;
    private string? _pendingVideoId;
    private bool _isSeeking;
    private double _seekValue;
    private bool _videoVisible = true;
    private bool _nowPlayingOpen;
    private bool _pendingModalFocus;
    private string _motionLevel = "full";
    private bool _systemReducedMotion;
    private bool _stageOpen;
    private bool _vinylMode = true;
    private string _visualizerMode = "bars";
    private string _stageTheme = "neon";
    private LyricDocument? _lyrics;
    private bool _lyricsAutoScroll = true;
    private int _lastLyricIndex = -1;
    private bool? _lastVisualizerPlaying;
    private string? _lastVisualizerMode;
    private string _visualState = "is-idle";

    // YT.PlayerState
    private const int StateEnded = 0;
    private const int StatePlaying = 1;
    private const int StatePaused = 2;
    private const int StateBuffering = 3;

    private double DisplayTime => _isSeeking ? _seekValue : PlayerState.CurrentTime;
    private int ActiveLyricIndex => _lyrics?.Lines.Count > 0
        ? _lyrics.Lines.FindLastIndex(line => line.StartMs <= PlayerState.CurrentTime * 1000) : -1;
    private void PauseLyricsScroll() => _lyricsAutoScroll = false;
    private void ResumeLyrics() { _lyricsAutoScroll = true; _lastLyricIndex = -1; }

    private string RepeatTitle => PlayerState.RepeatMode switch
    {
        RepeatMode.None => Lang.T("Bật lặp lại danh sách"),
        RepeatMode.All => Lang.T("Bật lặp lại một bài"),
        _ => Lang.T("Tắt lặp lại")
    };

    private bool IsCurrentFavorite =>
        PlayerState.CurrentTrack is not null && Favorites.IsFavorite(PlayerState.CurrentTrack.VideoId);

    protected override void OnInitialized()
    {
        PlayerState.OnChange += HandleStateChanged;
        PlayerState.OnTrackChanged += HandleTrackChanged;
        PlayerState.OnPlayPauseRequested += HandlePlayPauseRequested;
        Favorites.OnChange += HandleStateChanged;
        Lang.OnChange += HandleStateChanged;
    }

    private void ToggleVideo() => _videoVisible = !_videoVisible;

    private async Task OpenNowPlaying()
    {
        await JS.InvokeVoidAsync("anhTanEffects.beginCoverTransition");
        _nowPlayingOpen = true;
        _pendingModalFocus = true;
        _lastVisualizerPlaying = null;
    }

    private async Task CloseNowPlaying()
    {
        _nowPlayingOpen = false;
        _stageOpen = false;
        _lastVisualizerPlaying = null;
        await JS.InvokeVoidAsync("anhTanStage.stop");
        await JS.InvokeVoidAsync("anhTanStage.detachPanel");
        await JS.InvokeVoidAsync("anhTanStage.exitFullscreen");
        await JS.InvokeVoidAsync("anhTanEffects.closeModal");
    }

    private void ToggleVinyl() => _vinylMode = !_vinylMode;

    private void ToggleVisualizerMode() => _visualizerMode = _visualizerMode == "ring" ? "bars" : "ring";

    private async Task ToggleStageAsync()
    {
        if (_stageOpen)
        {
            _stageOpen = false;
            await JS.InvokeVoidAsync("anhTanStage.exitFullscreen");
        }
        else
        {
            _ = await JS.InvokeAsync<bool>("anhTanStage.enterFullscreen");
            _stageOpen = true;
        }
    }

    private async Task ChangeStageThemeAsync(ChangeEventArgs e)
    {
        _stageTheme = e.Value?.ToString() switch { "rain" => "rain", "vinyl" => "vinyl", _ => "neon" };
        await JS.InvokeVoidAsync("anhTanStage.setTheme", _stageTheme);
    }

    private async Task ChangeMotionLevelAsync(ChangeEventArgs e)
    {
        _motionLevel = e.Value?.ToString() switch { "off" => "off", "light" => "light", _ => "full" };
        await JS.InvokeVoidAsync("anhTanEffects.setLevel", _motionLevel);
        await JS.InvokeVoidAsync("anhTanStage.refresh");
    }

    private async Task ToggleCurrentFavoriteAsync()
    {
        var track = PlayerState.CurrentTrack;
        if (track is null)
        {
            return;
        }

        var added = await Favorites.ToggleFavoriteAsync(track);
        Toasts.ShowSuccess(added
            ? Lang.F("Đã thêm \"{0}\" vào yêu thích.", track.Title)
            : Lang.F("Đã xóa \"{0}\" khỏi yêu thích.", track.Title));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _motionLevel = await JS.InvokeAsync<string>("anhTanEffects.getLevel");
            _systemReducedMotion = await JS.InvokeAsync<bool>("anhTanEffects.prefersReducedMotion");
            _stageTheme = await JS.InvokeAsync<string>("anhTanStage.getTheme");
            await InvokeAsync(StateHasChanged);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vietmusicPlayer.initializePlayer", "youtube-player-host", _dotNetRef);
        }
        if (_pendingModalFocus)
        {
            _pendingModalFocus = false;
            await JS.InvokeVoidAsync("anhTanEffects.openModal", "now-playing");
            await JS.InvokeVoidAsync("anhTanEffects.endCoverTransition", ".now-playing-art");
            await JS.InvokeVoidAsync("anhTanStage.attachPanel", "now-playing-panel", _dotNetRef);
        }
        if (_nowPlayingOpen && (_lastVisualizerPlaying != (_visualState == "is-playing") || _lastVisualizerMode != _visualizerMode))
        {
            _lastVisualizerPlaying = _visualState == "is-playing";
            _lastVisualizerMode = _visualizerMode;
            await JS.InvokeVoidAsync("anhTanStage.mount", "stage-visualizer", _visualizerMode, _visualState == "is-playing");
        }
        if (_nowPlayingOpen && _lyricsAutoScroll && ActiveLyricIndex >= 0 && ActiveLyricIndex != _lastLyricIndex)
        {
            _lastLyricIndex = ActiveLyricIndex;
            await JS.InvokeVoidAsync("anhTanStage.scrollLyric", $"lyric-line-{_lastLyricIndex}");
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleTrackChanged(MusicTrack track)
    {
        _ = InvokeAsync(async () =>
        {
            _visualState = "is-loading";
            _lastVisualizerPlaying = null;
            _lyrics = null;
            _lyricsAutoScroll = true;
            _lastLyricIndex = -1;
            await LoadTrackAsync(track);
            _lyrics = await Lyrics.GetAsync(track.VideoId);
            StateHasChanged();
            _ = JS.InvokeVoidAsync("anhTanEffects.setArtworkColor", track.ThumbnailUrl);
            _ = Recent.AddAsync(track);
        });
    }

    private void HandlePlayPauseRequested(bool play)
    {
        _ = InvokeAsync(async () =>
        {
            if (!_playerReady)
            {
                return;
            }
            await JS.InvokeVoidAsync(play ? "vietmusicPlayer.playVideo" : "vietmusicPlayer.pauseVideo");
        });
    }

    private async Task LoadTrackAsync(MusicTrack track)
    {
        if (!_playerReady)
        {
            // Player chưa sẵn sàng — ghi nhớ để nạp khi onReady.
            _pendingVideoId = track.VideoId;
            return;
        }

        if (_loadedVideoId == track.VideoId)
        {
            // Bấm phát lại cùng một bài: phát tiếp thay vì nạp lại video.
            await JS.InvokeVoidAsync("vietmusicPlayer.playVideo");
            return;
        }

        _loadedVideoId = track.VideoId;
        await JS.InvokeVoidAsync("vietmusicPlayer.loadVideo", track.VideoId);
    }

    private async Task TogglePlayPause()
    {
        if (PlayerState.CurrentTrack is null || !_playerReady)
        {
            return;
        }

        if (PlayerState.IsPlaying)
        {
            await JS.InvokeVoidAsync("vietmusicPlayer.pauseVideo");
        }
        else
        {
            await JS.InvokeVoidAsync("vietmusicPlayer.playVideo");
        }
    }

    private void PlayNext()
    {
        if (!PlayerState.PlayNext())
        {
            Toasts.ShowInfo(Lang.T("Không có bài tiếp theo trong hàng đợi."));
        }
    }

    private void PlayPrevious()
    {
        if (!PlayerState.PlayPrevious())
        {
            Toasts.ShowInfo(Lang.T("Không có bài trước đó trong hàng đợi."));
        }
    }

    private void OnSeekInput(ChangeEventArgs e)
    {
        _isSeeking = true;
        if (TryParseSlider(e.Value, out var value))
        {
            _seekValue = value;
        }
    }

    private async Task OnSeekCommitAsync(ChangeEventArgs e)
    {
        if (TryParseSlider(e.Value, out var value) && _playerReady)
        {
            await JS.InvokeVoidAsync("vietmusicPlayer.seekTo", value);
        }
        _isSeeking = false;
    }

    // Trình duyệt gửi giá trị range dạng "31.5" (dấu chấm) — parse theo
    // InvariantCulture để không lỗi ở máy dùng dấu phẩy thập phân.
    private static bool TryParseSlider(object? raw, out double value)
        => double.TryParse(raw?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out value);

    private async Task OnVolumeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var volume))
        {
            PlayerState.SetVolume(volume);
            if (_playerReady)
            {
                await JS.InvokeVoidAsync("vietmusicPlayer.setVolume", volume);
            }
        }
    }

    private double SliderMax => PlayerState.Duration > 0 ? PlayerState.Duration : 100;

    // Render số cho thuộc tính value/max của input range (luôn dùng dấu chấm).
    private static string Inv(double v)
        => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatTime(double seconds)
    {
        if (seconds <= 0 || double.IsNaN(seconds))
        {
            return "0:00";
        }

        var time = TimeSpan.FromSeconds(seconds);
        return time.TotalHours >= 1
            ? $"{(int)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}"
            : $"{time.Minutes}:{time.Seconds:00}";
    }

    [JSInvokable]
    public Task OnStageFullscreenExited()
    {
        _stageOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPlayerReady()
    {
        _playerReady = true;
        await JS.InvokeVoidAsync("vietmusicPlayer.setVolume", PlayerState.Volume);

        if (_pendingVideoId is not null)
        {
            _loadedVideoId = _pendingVideoId;
            _pendingVideoId = null;
            await JS.InvokeVoidAsync("vietmusicPlayer.loadVideo", _loadedVideoId);
        }
    }

    [JSInvokable]
    public async Task OnPlayerStateChanged(int state)
    {
        switch (state)
        {
            case StatePlaying:
                _visualState = "is-playing";
                PlayerState.SetPlaying(true);
                break;
            case StatePaused:
                _visualState = "is-paused";
                PlayerState.SetPlaying(false);
                break;
            case StateBuffering:
                _visualState = "is-loading";
                PlayerState.SetPlaying(false);
                break;
            case StateEnded:
                _visualState = "is-ended";
                await HandleTrackEndedAsync();
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTrackEndedAsync()
    {
        if (PlayerState.RepeatMode == RepeatMode.One)
        {
            await JS.InvokeVoidAsync("vietmusicPlayer.seekTo", 0d);
            await JS.InvokeVoidAsync("vietmusicPlayer.playVideo");
            return;
        }

        if (!PlayerState.PlayNext())
        {
            PlayerState.SetPlaying(false);
        }
    }

    [JSInvokable]
    public void OnPlayerError(int errorCode)
    {
        _visualState = "is-error";
        var message = errorCode switch
        {
            101 or 150 => Lang.T("Video này không cho phép phát nhúng."),
            100 => Lang.T("Video không tồn tại hoặc đã bị xóa."),
            2 => Lang.T("Video không hợp lệ."),
            _ => Lang.T("Không phát được video này.")
        };

        var trackTitle = PlayerState.CurrentTrack?.Title;
        Toasts.ShowError(trackTitle is null ? message : $"{message} ({trackTitle})");

        // Tự chuyển bài tiếp theo nếu có.
        if (!PlayerState.PlayNext())
        {
            PlayerState.SetPlaying(false);
        }
    }

    [JSInvokable]
    public void OnPlayerProgress(double currentTime, double duration)
    {
        PlayerState.SetProgress(currentTime, duration);
    }

    public async ValueTask DisposeAsync()
    {
        if (_nowPlayingOpen)
        {
            try { await JS.InvokeVoidAsync("anhTanEffects.closeModal"); } catch (JSException) { }
            try { await JS.InvokeVoidAsync("anhTanStage.stop"); await JS.InvokeVoidAsync("anhTanStage.detachPanel"); } catch (JSException) { }
        }
        PlayerState.OnChange -= HandleStateChanged;
        PlayerState.OnTrackChanged -= HandleTrackChanged;
        PlayerState.OnPlayPauseRequested -= HandlePlayPauseRequested;
        Favorites.OnChange -= HandleStateChanged;
        Lang.OnChange -= HandleStateChanged;

        try
        {
            await JS.InvokeVoidAsync("vietmusicPlayer.destroyPlayer");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
    }
}
