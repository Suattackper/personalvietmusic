@inject MusicPlayerState PlayerState
@inject FavoritesService Favorites
@inject MyPlaylistService MyPlaylist
@inject ToastService Toasts

<div class="track-card @(IsActive ? "active" : null) @(IsActive && PlayerState.IsPlaying ? "is-playing" : null)"
     role="button"
     tabindex="0"
     aria-label="@Lang.F(IsActive && PlayerState.IsPlaying ? "Tạm dừng {0}" : "Phát {0}", Track.Title)"
     @onclick="PlayAsync"
     @onkeydown="HandleKeyDown">
    <div class="track-card-thumb">
        @if (!string.IsNullOrEmpty(Track.ThumbnailUrl))
        {
            <img src="@Track.ThumbnailUrl" alt="@Lang.F("Ảnh bìa {0}", Track.Title)" loading="lazy" />
        }
        else
        {
            <div class="track-card-thumb-fallback" aria-hidden="true">
                <Icon Name="music" Size="32" />
            </div>
        }
        <span class="track-card-play" aria-hidden="true">
            <Icon Name="@(IsActive && PlayerState.IsPlaying ? "pause" : "play")" Size="22" />
        </span>
        @if (Track.DurationText is not null)
        {
            <span class="track-card-duration" title="@Lang.F("Thời lượng {0}", Track.DurationText)">@Track.DurationText</span>
        }
        @if (IsActive)
        {
            <span class="track-card-playing-badge" aria-hidden="true">
                <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
            </span>
        }
    </div>
    <div class="track-card-body">
        <h4 class="track-card-title" title="@Track.Title">@Track.Title</h4>
        <p class="track-card-artist" title="@Track.Artist">@Track.Artist</p>
        @if (Track.PublishedAt.HasValue)
        {
            <p class="track-card-date">@Track.PublishedAt.Value.ToString("dd/MM/yyyy")</p>
        }
    </div>
    <div class="track-card-actions" @onclick:stopPropagation="true">
        <button class="icon-button @(IsFavorite ? "is-favorite" : null)"
                disabled="@_favoriteBusy"
                title="@Lang.T(IsFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")"
                aria-label="@Lang.T(IsFavorite ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")"
                @onclick="ToggleFavoriteAsync">
            <Icon Name="@(IsFavorite ? "heart-filled" : "heart")" Size="18" />
        </button>
        <button class="icon-button"
                title="@Lang.T("Thêm vào hàng đợi")"
                aria-label="@Lang.T("Thêm vào hàng đợi")"
                @onclick="AddToQueue">
            <Icon Name="plus" Size="18" />
        </button>
        <button class="icon-button @(IsInMyPlaylist ? "is-in-playlist" : null)"
                disabled="@_playlistBusy"
                aria-pressed="@IsInMyPlaylist"
                title="@Lang.T(IsInMyPlaylist ? "Xóa khỏi Playlist của tôi" : "Thêm vào Playlist của tôi")"
                aria-label="@Lang.T(IsInMyPlaylist ? "Xóa khỏi Playlist của tôi" : "Thêm vào Playlist của tôi")"
                @onclick="ToggleMyPlaylistAsync">
            <Icon Name="disc" Size="18" />
        </button>
        <a class="icon-button"
           href="https://www.youtube.com/watch?v=@Track.VideoId"
           target="_blank"
           rel="noopener noreferrer"
           title="@Lang.T("Mở trên YouTube")"
           aria-label="@Lang.T("Mở trên YouTube")"
           @onclick:stopPropagation="true">
            <Icon Name="external" Size="18" />
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MusicTrack Track { get; set; } = default!;

    /// <summary>Được gọi khi người dùng bấm Play/bấm vào card.</summary>
    [Parameter] public EventCallback<MusicTrack> OnPlay { get; set; }

    private bool IsActive => PlayerState.CurrentTrack?.VideoId == Track.VideoId;

    private bool IsFavorite => Favorites.IsFavorite(Track.VideoId);
    private bool IsInMyPlaylist => MyPlaylist.Contains(Track.VideoId);
    private bool _favoriteBusy;
    private bool _playlistBusy;

    private Task PlayAsync()
    {
        // Nếu đây đã là bài đang phát: bấm để tạm dừng / phát tiếp (không nạp lại từ đầu).
        // Nếu là bài khác: phát bài đó.
        if (IsActive)
        {
            PlayerState.RequestPlayPause(!PlayerState.IsPlaying);
            return Task.CompletedTask;
        }

        return OnPlay.InvokeAsync(Track);
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
        => e.Key is "Enter" or " " ? PlayAsync() : Task.CompletedTask;

    private async Task ToggleFavoriteAsync()
    {
        if (_favoriteBusy) return;
        _favoriteBusy = true;
        var track = Track;
        try
        {
            var added = await Favorites.ToggleFavoriteAsync(track);
            Toasts.ShowUndo(added
                ? Lang.F("Đã thêm \"{0}\" vào yêu thích.", track.Title)
                : Lang.F("Đã xóa \"{0}\" khỏi yêu thích.", track.Title), track.ThumbnailUrl,
                async () => { if (Favorites.IsFavorite(track.VideoId) == added) await Favorites.ToggleFavoriteAsync(track); });
        }
        finally { _favoriteBusy = false; }
    }

    private async Task ToggleMyPlaylistAsync()
    {
        if (_playlistBusy) return;
        _playlistBusy = true;
        var track = Track;
        try
        {
            var added = await MyPlaylist.ToggleAsync(track);
            Toasts.ShowUndo(added
                ? Lang.F("Đã thêm \"{0}\" vào Playlist của tôi.", track.Title)
                : Lang.F("Đã xóa \"{0}\" khỏi Playlist của tôi.", track.Title), track.ThumbnailUrl,
                async () => { if (MyPlaylist.Contains(track.VideoId) == added) await MyPlaylist.ToggleAsync(track); });
        }
        finally { _playlistBusy = false; }
    }

    private void AddToQueue()
    {
        var queuedTrack = new MusicTrack
        {
            VideoId = Track.VideoId,
            Title = Track.Title,
            Artist = Track.Artist,
            ThumbnailUrl = Track.ThumbnailUrl,
            PublishedAt = Track.PublishedAt
        };
        PlayerState.AddToQueue(queuedTrack);
        Toasts.ShowUndo(Lang.F("Đã thêm \"{0}\" vào hàng đợi.", Track.Title), Track.ThumbnailUrl,
            () => PlayerState.RemoveQueueItem(queuedTrack));
    }

}
