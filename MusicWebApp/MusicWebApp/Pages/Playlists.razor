@page "/playlists"
@inject PlaylistService PlaylistSvc
@inject PersonalPlaylistService Personal
@inject MusicPlayerState PlayerState
@inject NavigationManager Nav

<PageTitle>@Lang.T("Playlist") - AnhTanMusic</PageTitle>

<section class="page-section">
    <h1 class="page-heading">
        <span class="page-heading-icon" aria-hidden="true"><Icon Name="disc" Size="22" /></span>
        @Lang.T("Playlist có sẵn")
    </h1>
    <p class="page-subtitle">@Lang.T("Chọn một bộ sưu tập theo ngôn ngữ, tìm bài yêu thích rồi phát. Các playlist quen thuộc vẫn có bên dưới.")</p>

    @if (_playlists is null)
    {
        <div class="skeleton-grid" aria-label="@Lang.T("Đang tải playlist...")" role="status">
            @for (var i = 0; i < 6; i++) { <div class="skeleton skeleton-playlist"></div> }
        </div>
    }
    else if (_playlists.Count == 0)
    {
        <EmptyState IconName="disc"
                    Title="Chưa có playlist"
                    Description="Không tìm thấy dữ liệu playlist (data/playlists.json)." />
    }
    else
    {
        <h2 class="section-heading">@Lang.T("Playlist của tôi")</h2>
        <button class="playlist-card personal-playlist-card" @onclick="OpenPersonalPlaylist">
            <span class="playlist-card-art" aria-hidden="true"><span class="playlist-card-art-emoji">💜</span></span>
            <span class="playlist-card-body"><span class="playlist-card-name">@Lang.T("Playlist của tôi")</span><span class="playlist-card-desc">@Lang.T("Bộ sưu tập bài hát bạn đã lưu trên thiết bị này.")</span></span>
            <span class="playlist-card-count">@Lang.F("{0} bài", Personal.Tracks.Count)</span>
        </button>
        <h2 class="section-heading">@Lang.T("🌍 Chọn nhạc theo ngôn ngữ")</h2>
        <div class="playlist-grid country-playlist-grid">
            @foreach (var playlist in _playlists.Where(p => p.Id.StartsWith("country-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
        <h2 class="section-heading">@Lang.T("✨ Nhạc mới 2025–2026")</h2>
        <div class="playlist-grid country-playlist-grid">
            @foreach (var playlist in _playlists.Where(p => p.Id.StartsWith("recent-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
        <h2 class="section-heading">@Lang.T("🔥 TikTok viral theo ngôn ngữ")</h2>
        <p class="page-subtitle">@Lang.T("Mỗi danh sách có 100 bài tuyển từ nhiều mốc xu hướng; thứ tự không phải bảng xếp hạng TikTok chính thức.")</p>
        <div class="playlist-grid country-playlist-grid">
            @foreach (var playlist in _playlists.Where(p => p.Id.StartsWith("tiktok-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
        <h2 class="section-heading">@Lang.T("🎶 Playlist tuyển chọn")</h2>
        <div class="playlist-grid">
            @foreach (var playlist in _playlists.Where(p => !p.Id.StartsWith("country-") && !p.Id.StartsWith("recent-") && !p.Id.StartsWith("tiktok-")))
            {
                <PlaylistCard Playlist="playlist" @key="playlist.Id" />
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<CuratedPlaylist>? _playlists;

    protected override async Task OnInitializedAsync()
    {
        await Personal.InitializeAsync();
        _playlists = await PlaylistSvc.GetPlaylistsAsync();
    }

    private void OpenPersonalPlaylist()
    {
        if (Personal.Tracks.Count > 0) PlayerState.SetQueue(Personal.Tracks, 0);
        Nav.NavigateTo("my-playlist");
    }
}
