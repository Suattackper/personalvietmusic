@inject NavigationManager Nav

<button class="playlist-card"
        title="@Lang.T(IsCountryCollection ? "Mở danh sách" : "Phát playlist") @Lang.T(Playlist.Name)"
        aria-label="@Lang.T(IsCountryCollection ? "Mở danh sách" : "Phát playlist") @Lang.T(Playlist.Name) (@Lang.F("{0} bài", Playlist.Tracks.Count))"
        @onclick="Open">
    <span class="playlist-card-icon" aria-hidden="true">@Playlist.Emoji</span>
    <span class="playlist-card-body">
        <span class="playlist-card-name">@Lang.T(Playlist.Name)</span>
        <span class="playlist-card-desc">@Lang.T(Playlist.Description)</span>
    </span>
    <span class="playlist-card-count">@Lang.F("{0} bài", Playlist.Tracks.Count)</span>
    <span class="playlist-card-play" aria-hidden="true">
        <Icon Name="play" Size="18" />
    </span>
</button>

@code {
    [Parameter, EditorRequired] public CuratedPlaylist Playlist { get; set; } = default!;

    private bool IsCountryCollection => Playlist.Id.StartsWith("country-") || Playlist.Id.StartsWith("recent-") || Playlist.Id.StartsWith("tiktok-");

    private void Open()
    {
        // autoplay=1: trang chi tiết sẽ tự phát toàn bộ playlist ngay khi mở.
        Nav.NavigateTo(IsCountryCollection ? $"playlist/{Playlist.Id}" : $"playlist/{Playlist.Id}?autoplay=1");
    }
}
