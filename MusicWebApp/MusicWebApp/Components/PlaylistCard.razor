@inject NavigationManager Nav
@inject MusicPlayerState PlayerState

<button class="playlist-card"
        title="@Lang.T("Phát playlist") @Lang.T(Playlist.Name)"
        aria-label="@Lang.T("Phát playlist") @Lang.T(Playlist.Name) (@Lang.F("{0} bài", Playlist.Tracks.Count))"
        @onclick="Open">
    <span class="playlist-card-art" aria-hidden="true">
        @foreach (var track in Playlist.Tracks.Take(3))
        {
            <span class="playlist-card-art-layer" style="background-image:url('https://i.ytimg.com/vi/@track.VideoId/hqdefault.jpg')"></span>
        }
        <span class="playlist-card-art-emoji">@Playlist.Emoji</span>
    </span>
    <span class="playlist-card-body">
        <span class="playlist-card-name">@Lang.T(Playlist.Name)</span>
        <span class="playlist-card-desc">@Lang.T(Playlist.Description)</span>
    </span>
    <span class="playlist-card-count">@Lang.F("{0} bài", Playlist.Tracks.Count)</span>
    <span class="playlist-card-play" aria-hidden="true">
        <Icon Name="play" Size="18" />
    </span>
</button>

@code {
    [Parameter, EditorRequired] public CuratedPlaylist Playlist { get; set; } = default!;

    private void Open()
    {
        // Phát ngay trong thao tác bấm trước khi chuyển route, tránh hai lần nạp
        // và giữ cơ hội phát trên trình duyệt chặn autoplay sau điều hướng.
        if (Playlist.Tracks.Count > 0)
        {
            PlayerState.SetQueue(Playlist.Tracks.Select(t => t.ToMusicTrack()), 0);
        }
        Nav.NavigateTo($"playlist/{Playlist.Id}");
    }
}
